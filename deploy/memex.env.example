# Model endpoints for the api container (copy to deploy/memex.env; that file is not committed).
# Leave a group empty to keep that destination off: nothing is sent to it, the feature reports "unavailable".
MEMEX_LLM_URL=
MEMEX_LLM_MODEL=
MEMEX_LLM_KEY=
MEMEX_EMBED_URL=
MEMEX_EMBED_MODEL=
MEMEX_EMBED_KEY=
MEMEX_RERANK_URL=
MEMEX_RERANK_MODEL=
MEMEX_RERANK_KEY=
# Per-turn recall shows nothing until this is set (not calibrated yet, DESIGN §6.2).
MEMEX_RECALL_TAU=
